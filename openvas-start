#!/bin/bash
# OpenVAS / Greenbone Community Edition Service Start Script
# Compatible with Greenbone Community Edition 22.4+
#
# This script starts the modern GCE services:
# - openvasd (Notus Scanner daemon)
# - ospd-openvas (OSP daemon for OpenVAS Scanner)
# - gvmd (Greenbone Vulnerability Manager daemon)
# - gsad (Greenbone Security Assistant daemon)

set -e

echo "Starting Greenbone Community Edition Services..."

# Function to check if a service exists
service_exists() {
    systemctl list-unit-files | grep -q "^$1\.service"
}

# Function to start a service with fallback
start_service() {
    local service_name=$1
    local display_name=$2

    echo -n "Starting $display_name ($service_name)... "

    if systemctl is-active --quiet "$service_name" 2>/dev/null; then
        echo "already running"
        return 0
    fi

    if systemctl start "$service_name" 2>/dev/null; then
        echo "done"
        return 0
    else
        echo "failed"
        return 1
    fi
}

# Start services in correct order (dependencies first)
echo "======================================"
echo "Greenbone Community Edition Startup"
echo "======================================"
echo ""

# 1. Start openvasd (Notus Scanner)
start_service "openvasd" "OpenVASD (Notus Scanner)" || true

# 2. Start ospd-openvas (OSP Wrapper for OpenVAS Scanner)
start_service "ospd-openvas" "OSPd OpenVAS" || true

# 3. Start gvmd (Greenbone Vulnerability Manager)
start_service "gvmd" "GVM Daemon (gvmd)" || true

# 4. Start gsad (Greenbone Security Assistant)
start_service "gsad" "Greenbone Security Assistant (gsad)" || true

echo ""
echo "======================================"
echo "Service Status Summary"
echo "======================================"

# Show status of all services
for service in openvasd ospd-openvas gvmd gsad; do
    if systemctl is-active --quiet "$service" 2>/dev/null; then
        echo "  [✓] $service: running"
    else
        echo "  [✗] $service: not running"
    fi
done

echo ""
echo "Greenbone Security Assistant web interface should be available at:"
echo "  http://127.0.0.1:9392"
echo ""
echo "To check detailed service status, run:"
echo "  systemctl status <service-name>"

