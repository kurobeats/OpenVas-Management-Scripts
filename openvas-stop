#!/bin/bash
# OpenVAS / Greenbone Community Edition Service Stop Script
# Compatible with Greenbone Community Edition 22.4+
#
# This script stops the modern GCE services in reverse dependency order

set -e

echo "Stopping Greenbone Community Edition Services..."

# Function to stop a service
stop_service() {
    local service_name=$1
    local display_name=$2

    echo -n "Stopping $display_name ($service_name)... "

    if ! systemctl is-active --quiet "$service_name" 2>/dev/null; then
        echo "not running"
        return 0
    fi

    if systemctl stop "$service_name" 2>/dev/null; then
        echo "done"
        return 0
    else
        echo "failed"
        return 1
    fi
}

# Stop services in reverse order (reverse of startup)
echo "======================================"
echo "Greenbone Community Edition Shutdown"
echo "======================================"
echo ""

# 1. Stop gsad first (web interface)
stop_service "gsad" "Greenbone Security Assistant (gsad)" || true

# 2. Stop gvmd (manager)
stop_service "gvmd" "GVM Daemon (gvmd)" || true

# 3. Stop ospd-openvas (scanner wrapper)
stop_service "ospd-openvas" "OSPd OpenVAS" || true

# 4. Stop openvasd (notus scanner)
stop_service "openvasd" "OpenVASD (Notus Scanner)" || true

echo ""
echo "======================================"
echo "Service Status Summary"
echo "======================================"

# Show status of all services
for service in gsad gvmd ospd-openvas openvasd; do
    if systemctl is-active --quiet "$service" 2>/dev/null; then
        echo "  [✗] $service: still running"
    else
        echo "  [✓] $service: stopped"
    fi
done

echo ""
echo "All Greenbone Community Edition services have been stopped."

